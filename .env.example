# EcoLearn — environment template.
# Copy this file to `.env` and fill in your own key:
#   Windows : Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env
#
# Only GEMINI_API_KEY is needed for live features (assessment grading and
# "ask for help"). The roadmap and the 34 cached lessons run with NO key.

# Required for live LLM calls. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Generator / assessor model. Code default is gemma-3-27b-it; set the exact
# model id available on YOUR key from Google AI Studio.
# Examples: gemma-3-27b-it, gemma-3-12b-it, gemma-4-31b-it, gemini-2.5-flash
GEMINI_MODEL=gemma-3-27b-it

# Output token cap. Gemma needs headroom past its scratchpad; 2048 is safe.
GEMINI_MAX_OUTPUT_TOKENS=2048

# Only applies to gemini-2.5-flash* models. Leave commented for Gemma.
#GEMINI_THINKING_BUDGET=0
