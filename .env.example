# EcoLearn — environment template.
# Copy this file to `.env` and fill in your own key:
#   Windows      : Copy-Item .env.example .env
#   macOS/Linux  : cp .env.example .env
#
# WHAT NEEDS A KEY: only the two live paths — assessment grading and the
# "ask for help" doubt chat. The roadmap and all 34 cached lessons run with NO
# key at all, and every deterministic test runs offline.
#
# Everything below except GEMINI_API_KEY is OPTIONAL — each has a working code
# default. They are listed so you know which knobs exist.

# =============================================================================
# REQUIRED for live features
# =============================================================================
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# =============================================================================
# MODEL SELECTION  (per-role, because each model has its OWN daily free-tier
# quota bucket — spreading roles across models is what keeps the app alive)
# =============================================================================
# Generator + assessor. Code default is gemma-3-27b-it, but that model 404s on
# some keys — gemma-4-31b-it is what this project actually runs on. Set the
# exact id available on YOUR key in Google AI Studio.
GEMINI_MODEL=gemma-4-31b-it

# Output token cap. Gemma needs headroom past its scratchpad before it reaches
# the real answer; 1024 produced empty responses, so 2048 is the safe floor.
GEMINI_MAX_OUTPUT_TOKENS=2048

# Only applies to gemini-2.5-flash* models. Leave commented for Gemma —
# Gemma does not accept thinking_config at all.
#GEMINI_THINKING_BUDGET=0

# The cheap JSON judges + the polisher. Defaults are gemini-2.5-flash-lite.
# Both have fallback chains in code, so a 429 on one model is survivable.
#CRITIC_MODEL=gemini-2.5-flash-lite
#POLISHER_MODEL=gemini-2.5-flash-lite

# The assessor splits question-generation from grading so they can sit on
# different quota buckets. Both default to GEMINI_MODEL's family.
#ASSESSOR_QUESTION_MODEL=gemma-4-31b-it
#ASSESSOR_GRADE_MODEL=gemma-4-31b-it

# =============================================================================
# PATHS + BEHAVIOUR OVERRIDES  (mostly used by tests)
# =============================================================================
# Where the SQLite progress/learner store lives. Default: data/progress.db.
# Every test sets this to a temp file BEFORE importing the store module.
#ECOLEARN_PROGRESS_DB=data/progress.db

# Curriculum YAML path. Default: data/curriculum/physics.yaml
#ECOLEARN_CURRICULUM=data/curriculum/physics.yaml

# How many days a mastered concept may go unrevisited before the path engine
# surfaces it for spaced-repetition review. Default: 7
#ECOLEARN_REVIEW_DAYS=7

# =============================================================================
# AUTH  (Milestone 0 — needed once api/security.py exists)
# =============================================================================
# Secret for signing HS256 session tokens. A dev default is used if unset (with
# a warning); in production the app refuses to start without it.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#ECOLEARN_JWT_SECRET=

# =============================================================================
# FRONTEND
# =============================================================================
# The Next.js app reads its own file, web/.env.local (NOT this one), because
# only NEXT_PUBLIC_* vars reach the browser:
#     NEXT_PUBLIC_API_URL=http://localhost:8000
